# URL de la app de CLUBIO — el form de demo postea a {URL}/api/leads
# Importante: usar "www" en producción (el apex "clubio.com.ar" redirige
# a "www" con un 307, y eso rompe el preflight de CORS del browser).
# En desarrollo local, apuntar a la app corriendo en localhost (ej. http://localhost:3000).
NEXT_PUBLIC_CLUBIO_API_URL=http://localhost:3000
